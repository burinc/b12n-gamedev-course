{:min-bb-version "1.3.0"
 :tasks
 {:requires ([babashka.fs] [babashka.process :refer [shell]] [clojure.string])

  help
  {:doc "List available tasks"
   :task (println (str "Lisp Gamedev Course: `bb check` compiles the "
                       "vendored engine and every exercise (solution + "
                       "starter) headlessly, `bb test` runs the engine's "
                       "PURE unit tests (no window, see `bb test`'s own "
                       "--doc for the windowed subset it skips). Run one "
                       "exercise directly: `clojure -M:run -m "
                       "<its-namespace>` (each lesson gives you the exact "
                       "command)."))}

  check
  {:doc "Headless compile-check of the vendored engine + every exercise (solution + starter)"
   :task (shell "clojure" "-M:check" "-e"
                (str "(doseq [ns '[gamedev-course.engine.raylib.core "
                     "gamedev-course.engine.raylib.enums "
                     "gamedev-course.engine.raylib.core.window "
                     "gamedev-course.engine.raylib.core.drawing "
                     "gamedev-course.engine.raylib.core.keyboard "
                     "gamedev-course.engine.raylib.core.mouse "
                     "gamedev-course.engine.raylib.core.timing "
                     "gamedev-course.engine.raylib.shapes.basic "
                     "gamedev-course.engine.raylib.text.drawing "
                     "gamedev-course.engine.smoke "
                     "gamedev-course.engine.game-loop "
                     "phase-1.bouncing-ball "
                     "phase-1.following-eyes "
                     "phase-1.following-eyes-starter "
                     "phase-2.pong "
                     "phase-2.pong-starter "
                     "phase-2.breakout "
                     "phase-2.breakout-starter "
                     "phase-2.snake "
                     "phase-2.snake-starter "
                     "phase-2.space-invaders "
                     "phase-2.space-invaders-starter "
                     "phase-2.tetris "
                     "phase-2.tetris-starter "
                     "phase-2.flappy-bird "
                     "phase-2.flappy-bird-starter]] (require ns)) "
                     "(println :bb-check-ok)"))}

  test
  {:doc "Run the engine's PURE unit tests (clojure.test via cognitect test-runner). Excludes `^:windowed` tests, which open a real GLFW window and need a live display, run those yourself with `clojure -M:test` (no filter) when you have one."
   :task (shell "clojure" "-M:test" "-e" "windowed")}

  record
  {:doc "Re-record the course demo GIFs into docs/demos/ from scripts/demo_manifest.edn. Maintainer-only: needs a live display and the macOS screen-recording grant (check with `screen-grab doctor`). Passes flags straight through, e.g. `bb record --only tetris --force`, `bb record --dry-run`."
   ;; NOTE: bb.edn bodies are EDN-parsed — no #"regex", no @deref, no #(...).
   :task (apply shell "screen-grab" "record" *command-line-args*)}

  docs-sync
  {:doc "Rebuild the docs site via ~/dev/b12n-docs, commit + push the site repo, then publish to S3 + CloudFront. Maintainer task (needs the sibling b12n-docs + site repos and the b12n AWS profile). Exits NON-ZERO if any step fails, or if the deploy is skipped for any reason other than --no-deploy. bb docs-sync [--no-deploy]"
   ;; The distribution id is looked up by alias, never hardcoded: tofu owns
   ;; it, and a stale id would invalidate someone else's site.
   ;; NOTE: bb.edn bodies are EDN-parsed, so no #"regex", no @deref and no
   ;; #(...) literals in here.
   :task
   (let [home      (System/getProperty "user.home")
         docs-repo (str home "/dev/b12n-docs")
         site-repo (str home "/dev/b12n-gamedev-course.github.io")
         bucket    "b12n-site-lisp-gamedev"
         site-host "lisp-gamedev.b12n.app"
         deploy?   (not (contains? (set *command-line-args*) "--no-deploy"))
         hdr       (fn [s] (println (str "\n== " s " ==")))

         ;; Every step returns a keyword. :ok and :deploy-disabled are the
         ;; ONLY two that mean nothing went wrong. This is an allowlist, not
         ;; a denylist, on purpose: a failure mode added later then fails
         ;; loudly by default instead of slipping through as a silent
         ;; success, which is exactly how a skipped deploy used to exit 0.
         good?     (fn [r] (contains? #{:ok :deploy-disabled} r))

         build!
         (fn []
           (hdr "1/4 Rebuild")
           (let [b (shell {:dir docs-repo :continue true}
                          "bb" "site:build" "b12n-gamedev-course")]
             (if (zero? (:exit b))
               :ok
               (do (println "  BUILD FAILED") :build-failed))))

         commit!
         (fn []
           (hdr "2/4 Commit the site repo")
           (shell {:dir site-repo :continue true} "git" "add" "docs")
           (let [st (:out (shell {:dir site-repo :out :string :continue true}
                                 "git" "status" "--porcelain"))]
             (if (clojure.string/blank? (clojure.string/trim (or st "")))
               (do (println "  no changes") :ok)
               (let [c (shell {:dir site-repo :continue true}
                              "git" "commit" "-m" "build: regenerate docs site")]
                 (if (zero? (:exit c))
                   (do (println "  committed") :ok)
                   (do (println "  COMMIT FAILED") :commit-failed))))))

         ;; The site repo used to have no remote at all, so its history
         ;; existed only on one laptop. Pushing is part of the job now, and
         ;; a missing remote is a reportable failure rather than a shrug.
         push!
         (fn []
           (hdr "3/4 Push the site repo")
           (let [r  (shell {:dir site-repo :out :string :continue true} "git" "remote")
                 rs (clojure.string/trim (or (:out r) ""))]
             (if (clojure.string/blank? rs)
               (do (println "  NO REMOTE configured - this repo lives only on this machine.")
                   (println "  Add one, then re-run:")
                   (println (str "    git -C " site-repo " remote add origin <url> && git -C " site-repo " push -u origin main"))
                   :no-remote)
               (let [p (shell {:dir site-repo :continue true} "git" "push")]
                 (if (zero? (:exit p))
                   (do (println "  pushed") :ok)
                   (do (println "  PUSH FAILED") :push-failed))))))

         deploy!
         (fn []
           (hdr "4/4 Deploy to S3 + CloudFront")
           (cond
             (not deploy?)
             (do (println "  skipped (--no-deploy)") :deploy-disabled)

             (not (babashka.fs/which "aws"))
             (do (println "  DEPLOY SKIPPED - aws CLI not on PATH.") :aws-missing)

             :else
             (let [probe (shell {:continue true :out :string :err :string}
                                "aws" "s3api" "head-bucket" "--bucket" bucket
                                "--profile" "b12n")]
               (if-not (zero? (:exit probe))
                 ;; head-bucket failing does NOT by itself mean the bucket is
                 ;; missing. It fails identically when the CLI cannot reach AWS
                 ;; at all - and on a restricted laptop HTTPS_PROXY is set,
                 ;; which the AWS CLI honours, so every call dies at the proxy
                 ;; while DNS and git keep working. Sending someone to
                 ;; tofu:apply for that means creating infrastructure that
                 ;; already exists. So classify before advising anything.
                 (let [err   (clojure.string/lower-case (str (:err probe) " " (:out probe)))
                       said  (first (clojure.string/split-lines
                                     (clojure.string/trim (str (:err probe) (:out probe)))))
                       hit?  (fn [ss] (some (fn [s] (clojure.string/includes? err s)) ss))
                       proxy (or (System/getenv "HTTPS_PROXY") (System/getenv "https_proxy"))]
                   (cond
                     (hit? ["proxy" "could not connect" "connect timeout" "endpoint url"
                            "name resolution" "network is unreachable" "connection refused"
                            "timed out" "connection was closed"])
                     (do (println "  DEPLOY SKIPPED - could not reach AWS at all.")
                         (println (str "    " said))
                         (println "  This is a network problem on THIS MACHINE. It is NOT evidence")
                         (println "  about whether the bucket exists - do NOT run tofu:apply for it.")
                         (when proxy
                           (println (str "  HTTPS_PROXY is set (" proxy ") and the AWS CLI honours it.")))
                         (println "  On a restricted laptop that proxy is the usual cause. Retry with:")
                         (println "    unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy && bb docs-sync")
                         :unreachable)

                     (hit? ["unable to locate credentials" "no credentials" "expiredtoken"
                            "expired" "invalidclienttokenid" "signaturedoesnotmatch"
                            "sso session" "token has expired"])
                     (do (println "  DEPLOY SKIPPED - AWS credentials for profile b12n are missing or expired.")
                         (println (str "    " said))
                         (println "  Refresh them and re-run. The infrastructure is unaffected.")
                         :credentials)

                     (hit? ["403" "forbidden" "accessdenied"])
                     (do (println (str "  DEPLOY SKIPPED - s3://" bucket " EXISTS but profile b12n cannot read it (403)."))
                         (println (str "    " said))
                         (println "  That is a permissions problem, not missing infrastructure.")
                         :forbidden)

                     (hit? ["404" "not found" "nosuchbucket"])
                     (do (println (str "  DEPLOY SKIPPED - s3://" bucket " does not exist."))
                         (println "  THIS is the one that needs infrastructure. Run once in ~/dev/b12n-infra:")
                         (println "    bb render lock tofu:init tofu:plan tofu:apply -- static-site lisp-gamedev")
                         :missing-bucket)

                     :else
                     (do (println (str "  DEPLOY SKIPPED - head-bucket on s3://" bucket " failed for an unrecognized reason."))
                         (println (str "    " said))
                         (println "  Check by hand before assuming anything:")
                         (println (str "    aws s3api head-bucket --bucket " bucket " --profile b12n"))
                         :probe-failed)))
                 (let [s (shell {:continue true} "aws" "s3" "sync"
                                (str site-repo "/docs/") (str "s3://" bucket "/")
                                "--profile" "b12n" "--delete")]
                   (if-not (zero? (:exit s))
                     (do (println "  S3 SYNC FAILED") :sync-failed)
                     (let [q  (str "DistributionList.Items[?contains(Aliases.Items, `"
                                   site-host "`)].Id | [0]")
                           d  (shell {:continue true :out :string}
                                     "aws" "cloudfront" "list-distributions"
                                     "--profile" "b12n" "--query" q "--output" "text")
                           id (clojure.string/trim (or (:out d) ""))]
                       (if (or (clojure.string/blank? id) (= id "None"))
                         (do (println (str "  synced, but no CloudFront distribution found for " site-host))
                             (println "  (cache not invalidated, the edge may serve stale files for a while)")
                             :no-distribution)
                         (let [inv (shell {:continue true} "aws" "cloudfront"
                                          "create-invalidation" "--profile" "b12n"
                                          "--distribution-id" id "--paths" "/*")]
                           (if (zero? (:exit inv))
                             (do (println (str "  synced + invalidated (" id "), https://" site-host)) :ok)
                             (do (println "  synced, but INVALIDATION FAILED") :invalidation-failed)))))))))))]
     ;; A failed build makes every later step meaningless, so stop there.
     (let [b (build!)]
       (if-not (good? b)
         (do (hdr "Summary") (println (str "  build:  " b)) (System/exit 1))
         (let [c (commit!)
               p (push!)
               d (deploy!)]
           (hdr "Summary")
           (println (str "  build:  " b))
           (println (str "  commit: " c))
           (println (str "  push:   " p))
           (println (str "  deploy: " d))
           (when-not (every? good? [b c p d])
             (println "\n  One or more steps did not succeed - exiting 1.")
             (System/exit 1))))))}}}
